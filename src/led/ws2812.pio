.pio_version 0

; WS2812 uses one 24-bit GRB frame at 800 kHz and latches it after a low
; level of at least 50 us. Each bit occupies ten PIO cycles.
.program ws2812
.side_set 1

.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void ws2812_program_init(PIO pio, uint sm, uint offset,
                                       uint pin, float frequency, bool rgbw) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config config = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&config, pin);
    sm_config_set_out_shift(&config, false, true, rgbw ? 32 : 24);
    sm_config_set_fifo_join(&config, PIO_FIFO_JOIN_TX);

    constexpr int cyclesPerBit = ws2812_T1 + ws2812_T2 + ws2812_T3;
    const float clockDivider = clock_get_hz(clk_sys) /
                               (frequency * cyclesPerBit);
    sm_config_set_clkdiv(&config, clockDivider);

    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_enabled(pio, sm, true);
}
%}
