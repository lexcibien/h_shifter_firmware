{
  "languages": {
    "C": {
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "C++": {
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--query-driver=**/arm-none-eabi-*",
          "--clang-tidy",
          "--background-index-priority=background"
        ]
      }
    }
  }
}
