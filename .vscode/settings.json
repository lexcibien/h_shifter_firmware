{
  "cSpell.words": [
    "Adafruit",
    "arduino",
    "atmelavr",
    "bugprone",
    "buildcache",
    "clangtidy",
    "cppcheck",
    "cppcoreguidelines",
    "DLEONARDO",
    "DPICO",
    "DRPIPICO",
    "DUSBCON",
    "gamepad",
    "GAMEPAD",
    "hicpp",
    "Iboards",
    "leonardo",
    "llvmlibc",
    "mheironimus",
    "NOLINTNEXTLINE",
    "rpipico",
    "TINYUSB",
    "unflags",
    "USBD",
    "waveshare",
    "Werror"
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.enable": true,
  "sonarlint.pathToCompileCommands": "${workspaceFolder}/compile_commands.json",
  "clangd.arguments": [
    "--query-driver=**/arm-none-eabi-*"
  ]
}
