{
  "cSpell.words": [
    "adafruit",
    "Adafruit",
    "arduino",
    "bugprone",
    "buildcache",
    "compiledb",
    "cppcheck",
    "cppcoreguidelines",
    "DCFG",
    "DDEBUG",
    "DSHIFTER",
    "DTINYUSB",
    "earlephilhower",
    "fstack",
    "github",
    "hicpp",
    "Iboards",
    "Iinclude",
    "libdeps",
    "llvmlibc",
    "microcontroller",
    "NEOPIXEL",
    "NOLINTNEXTLINE",
    "RHPORT",
    "TINYUSB",
    "tusb",
    "TUSB",
    "unflags",
    "USBD",
    "vararg",
    "waveshare",
    "Waveshare"
  ],
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.enable": true,
  "sonarlint.pathToCompileCommands": "${workspaceFolder}/compile_commands.json",
  "clangd.arguments": [
    "--query-driver=**/arm-none-eabi-*",
    "--clang-tidy",
    "--background-index-priority=background"
  ]
}
