{
  "cSpell.words": [
    "adafruit",
    "Adafruit",
    "arduino",
    "atmelavr",
    "bugprone",
    "buildcache",
    "clangtidy",
    "compiledb",
    "cppcheck",
    "cppcoreguidelines",
    "DDEBUG",
    "DLEONARDO",
    "DPICO",
    "DRPIPICO",
    "DSHIFTER",
    "DUSBCON",
    "earlephilhower",
    "fstack",
    "gamepad",
    "GAMEPAD",
    "github",
    "hicpp",
    "Iboards",
    "leonardo",
    "llvmlibc",
    "mheironimus",
    "NEOPIXEL",
    "NOLINTNEXTLINE",
    "PIOENV",
    "rpipico",
    "TINYUSB",
    "unflags",
    "USBD",
    "vararg",
    "waveshare",
    "Werror"
  ],
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.enable": true,
  "sonarlint.pathToCompileCommands": "${workspaceFolder}/compile_commands.json",
  "clangd.arguments": [
    "--query-driver=**/arm-none-eabi-*",
    "--clang-tidy",
    "--background-index-priority=background"
  ]
}
